JWT_SECRET=replace-with-a-long-random-string
QR_SIGNING_SECRET=replace-with-a-long-random-string
PORT=3000

# Low-privilege shared secret for kiosk display screens only.
# Not a real login credential — allows display kiosks to fetch rotating QR codes without an admin JWT session.
# Should still be kept reasonably private, but a leak only exposes the ability to view rotating QR codes, nothing else.
KIOSK_DISPLAY_KEY=replace-with-a-long-random-string

# Geofence verification mode: "off", "log", or "enforce" (default: "log")
# Use "off" during development/demo. Use "enforce" only once coordinates below are correct.
GEOFENCE_MODE=off

# Maximum permissible GPS accuracy in meters in enforce mode (default: 50)
GEOFENCE_MAX_ACCURACY_M=50

# GPS center of your office/campus — used as the geofence origin for all departments.
# Find your coordinates: https://www.latlong.net/ or Google Maps (right-click → coordinates)
# GEOFENCE_LAT and GEOFENCE_LNG MUST be set correctly before enabling "enforce" mode.
GEOFENCE_LAT=YOUR_LATITUDE_HERE
GEOFENCE_LNG=YOUR_LONGITUDE_HERE
GEOFENCE_RADIUS_M=200

# Test-only secret for X-Test-Secret header overrides (automated tests only; must never be set in staging or production)
TEST_OVERRIDE_SECRET=replace-with-test-override-secret
