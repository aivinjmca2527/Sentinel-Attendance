JWT_SECRET=replace-with-a-long-random-string
QR_SIGNING_SECRET=replace-with-a-long-random-string
PORT=3000

# Geofence verification mode: "off", "log", or "enforce" (default: "log")
GEOFENCE_MODE=log

# Maximum permissible GPS accuracy in meters in enforce mode (default: 50)
GEOFENCE_MAX_ACCURACY_M=50

# Test-only secret for X-Test-Secret header overrides (automated tests only; must never be set in staging or production)
TEST_OVERRIDE_SECRET=replace-with-test-override-secret
