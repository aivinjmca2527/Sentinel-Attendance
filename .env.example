JWT_SECRET=replace-with-a-long-random-string
QR_SIGNING_SECRET=replace-with-a-long-random-string
PORT=3000

# Low-privilege shared secret for kiosk display screens only.
# Not a real login credential — allows display kiosks to fetch rotating QR codes without an admin JWT session.
# Should still be kept reasonably private, but a leak only exposes the ability to view rotating QR codes, nothing else.
KIOSK_DISPLAY_KEY=replace-with-a-long-random-string

# Geofence verification mode: "off", "log", or "enforce" (default: "log")
GEOFENCE_MODE=log

# Maximum permissible GPS accuracy in meters in enforce mode (default: 50)
GEOFENCE_MAX_ACCURACY_M=50

# Test-only secret for X-Test-Secret header overrides (automated tests only; must never be set in staging or production)
TEST_OVERRIDE_SECRET=replace-with-test-override-secret

# ─── Face Authentication ─────────────────────────────────────────────────────

# Face verification mode: "off" (default), "log", or "enforce"
# off = face auth disabled, system behaves as before
# log = validate face proof and log alerts, but don't block attendance
# enforce = require valid face proof for attendance
FACE_MODE=off

# Face recognition provider: "local" (default) or "mock" (test only, refuses to load in production)
FACE_PROVIDER=local

# Euclidean distance threshold for face match (lower = stricter). Default: 0.5
FACE_MATCH_THRESHOLD=0.5

# JWT secret for signing face proof tokens. MUST differ from JWT_SECRET.
# Required when FACE_MODE is "log" or "enforce"; server refuses to start without it.
FACE_PROOF_SECRET=replace-with-a-different-long-random-string

# Face proof token lifetime in seconds (default: 120)
FACE_PROOF_TTL_SECONDS=120

# Challenge lifetime in seconds (default: 30)
FACE_CHALLENGE_TTL_SECONDS=30

# Minimum head-turn yaw angle in degrees for liveness check (default: 15)
FACE_MIN_YAW_DELTA=15

# Maximum failed face verification attempts before lockout (default: 5)
FACE_MAX_FAILED_ATTEMPTS=5

# Lockout duration in minutes after max failed attempts (default: 15)
FACE_LOCKOUT_MINUTES=15

# Store raw reference face photo on disk. Default: false (only embedding is stored)
FACE_STORE_PHOTO=false

# Maximum image upload size in bytes per image (default: 1500000 = 1.5 MB)
FACE_MAX_IMAGE_BYTES=1500000
